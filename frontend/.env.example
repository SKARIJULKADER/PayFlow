# PayFlow API configuration (optional)
#
# Leave this unset for local development: the Vite dev server proxies /api to the
# Express backend on http://localhost:3000 (see vite.config.js).
#
# For a deployed frontend, point the app at the absolute API base — it must
# include the /api/v1 prefix that the backend mounts its routes on.
VITE_API_URL=https://your-payflow-api.example.com/api/v1
